# Copy this file to .env and fill in your own key (never commit .env itself).
# Used by tools/cqa/context7-headers.js to authenticate the project-scoped
# Context7 MCP server declared in .mcp.json — grounds VERSION_BRIEF.md's
# version-rules lookups against current docs instead of training data. The
# pipeline runs fine without it (falls back to the free-tier rate limit); see
# tools/cqa/PIPELINE.md's FAQ for how many calls a run actually uses.
CONTEXT7_API_KEY=
